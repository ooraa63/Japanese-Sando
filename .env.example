# =============================================================================
# Japanese Sando — environment variables template
# =============================================================================
# Copy this file to `.env.local` and fill in the real values.
# DO NOT commit `.env.local` to git (it's in .gitignore).
# =============================================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------- Midtrans (Sandbox / Production) ----------
# Sandbox keys are visible in Midtrans Dashboard → Settings → Access Keys.
# Production keys are SEPARATE — never reuse Sandbox keys for live.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=<midtrans-client-key>
MIDTRANS_SERVER_KEY=<midtrans-server-key>
MIDTRANS_IS_PRODUCTION=false

# ---------- Google OAuth (Client-Side GIS) ----------
# Client ID from Google Cloud Console → APIs & Services → Credentials.
# Used by `src/lib/googleAuth.ts` to drive the popup account chooser.
# The matching Client Secret is configured in **Supabase Dashboard** →
# Authentication → Providers → Google (NOT here — Supabase verifies JWT
# signature with that secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com

# ---------- Public site URL ----------
# Used by OAuth redirect callback and QRIS notification URLs.
NEXT_PUBLIC_SITE_URL=https://japanese-sando.vercel.app