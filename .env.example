# =============================================================================
# Japanese Sando — environment variables template
# =============================================================================
# Copy this file to `.env.local` and fill in the real values.
# DO NOT commit `.env.local` to git (it's in .gitignore).
# =============================================================================

# ---------- Supabase ----------
# URL project Supabase. Bisa dilihat di Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (dahulu "anon key"). Dulu di-prefix NEXT_PUBLIC_SUPABASE_ANON_KEY;
# sekarang namanya PUBLISHABLE_KEY di Supabase baru.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Connection string Postgres untuk `npm run db-push`. Pakai Session pooler
# (host aws-0-<region>.pooler.supabase.com) — bukan direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------- Midtrans ----------
# Sandbox keys terlihat di Midtrans Dashboard → Settings → Access Keys.
# Production keys TERPISAH — jangan pakai Sandbox key untuk live.
#   - `MIDTRANS_SERVER_KEY`  : pakai environment SERVER (NextJS server actions).
#     WAJIB prefix gak ada (server-only) — JANGAN taruh NEXT_PUBLIC_.
#   - `MIDTRANS_IS_PRODUCTION`: "true" untuk production deploy, "false" untuk
#     development / preview deployment.
MIDTRANS_SERVER_KEY=<midtrans-server-key>
MIDTRANS_IS_PRODUCTION=false

# ---------- Public site URL ----------
# Dipakai untuk generate callback URL OAuth + jadi metadataBase layout.
# Production: https://japanese-sando.vercel.app
# Preview: auto pakai VERCEL_URL (lihat fallback di src/app/layout.tsx).
NEXT_PUBLIC_SITE_URL=https://japanese-sando.vercel.app

# ---------- Mapbox (pilih alamat di peta) ----------
# Tanpa token ini, peta di form alamat pembeli (/order) dan di form zona
# pengiriman admin (/admin/pickup-delivery) TIDAK muncul — hanya panel merah
# "Mapbox token belum disetel".
# Token ini PUBLIK (prefix `pk.`), bukan rahasia: memang dipakai di browser.
# Ambil di https://account.mapbox.com/access-tokens/ (default token sudah ada
# begitu akun dibuat, tidak butuh kartu kredit).
# PENTING: variabel NEXT_PUBLIC_* di-inline saat BUILD, jadi di Vercel token
# harus ditambah dulu, baru build ulang — restart saja tidak cukup.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.<public-access-token>