# Salin file ini jadi .env.local lalu isi nilainya.
# JANGAN commit .env.local ke GitHub.

# Alamat website (dipakai untuk metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Supabase =====
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<kode-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Hanya dipakai oleh `npm run db:push` (script migrasi), tidak dibaca aplikasi.
# Dashboard > Project Settings > Database > Connection string > Session pooler
#
# PENTING: password harus di-encode untuk URL.
#   /  ->  %2F      +  ->  %2B      @  ->  %40      #  ->  %23
# Contoh password  /i7R7p_je6DG66+  ditulis  %2Fi7R7p_je6DG66%2B
DATABASE_URL=postgresql://postgres.<kode-project>:<password-terencode>@aws-0-<region>.pooler.supabase.com:5432/postgres
