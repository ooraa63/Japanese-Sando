# =============================================================================
# Japanese Sando — environment variables template
# =============================================================================
# Copy this file to `.env.local` and fill in the real values.
# DO NOT commit `.env.local` to git (it's in .gitignore).
# =============================================================================

# ---------- Supabase ----------
# URL project Supabase. Bisa dilihat di Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (dahulu "anon key"). Dulu di-prefix NEXT_PUBLIC_SUPABASE_ANON_KEY;
# sekarang namanya PUBLISHABLE_KEY di Supabase baru.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Connection string Postgres untuk `npm run db-push`. Pakai Session pooler
# (host aws-0-<region>.pooler.supabase.com) — bukan direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------- Midtrans ----------
# Key ada di Midtrans Dashboard → Settings → Access Keys, DIAMBIL DARI DROPDOWN
# ENVIRONMENT (Sandbox atau Production). Keduanya BERBEDA.
#   - `MIDTRANS_SERVER_KEY`  : dipakai di environment SERVER (NextJS server
#     actions). WAJIB tanpa prefix NEXT_PUBLIC_ (server-only).
#   - `NEXT_PUBLIC_MIDTRANS_CLIENT_KEY`: key publik untuk sisi klien.
#   - `MIDTRANS_IS_PRODUCTION`: "true" hanya kalau merchant sudah AKTIF di
#     production (verifikasi bisnis selesai → dashboard Step 4 "Result").
#
# PENTING — jangan pakai prefix key untuk menentukan mode:
#   - prefix `SB-Mid-...` = sandbox, prefix `Mid-...` = production, TAPI
#     merchant bisa punya key ber-prefix production yang belum aktif.
#   - Yang menentukan: host mana yang MENERIMA key itu. Cek dengan probe
#     read-only (GET status order dummy, tidak membuat transaksi):
#       https://api.midtrans.com       -> 404 = aktif, 401 Unknown Merchant = belum
#     Set "true" hanya setelah probe itu 404.
#   - Salah set "true" = opsi QRIS tetap nongol di UI tapi charge selalu 401.
#
# Saat production aktif, update `.env.local` DAN Vercel Production env
# BERBARUAN. Webhook pakai server key yang sama untuk verifikasi signature;
# kalau Vercel masih pakai key lama, webhook membalas 403 dan status order
# tidak pernah sinkron.
MIDTRANS_SERVER_KEY=<midtrans-server-key>
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=<midtrans-client-key>
MIDTRANS_IS_PRODUCTION=false

# ---------- Public site URL ----------
# Dipakai untuk generate callback URL OAuth + jadi metadataBase layout.
# Production: https://japanese-sando.vercel.app
# Preview: auto pakai VERCEL_URL (lihat fallback di src/app/layout.tsx).
NEXT_PUBLIC_SITE_URL=https://japanese-sando.vercel.app

# ---------- Peta ----------
# TIDAK ADA lagi. Mapbox dicabut 12-10-2026: pembeli mengetik alamat dan
# detail sendiri, jadi `NEXT_PUBLIC_MAPBOX_TOKEN` sudah dihapus dari contoh ini.
# Dependency `mapbox-gl` juga sudah dilepas dari package.json.